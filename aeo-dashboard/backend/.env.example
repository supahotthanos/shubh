# Copy to .env and fill in as needed. All external API keys are optional —
# the app runs on deterministic mock providers when keys are absent.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aeo_dashboard
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-in-production
DEMO_USER_EMAIL=demo@aeo.local
DEMO_USER_PASSWORD=demo1234

PROVIDER_MODE=auto   # mock | real | auto

# Optional external APIs (unset = use mock providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=
AHREFS_API_KEY=
MOZ_API_KEY=
GSC_CREDENTIALS_PATH=

CORS_ORIGINS=["http://localhost:3000"]
